    "build": "../fudami-design/node_modules/.bin/tailwindcss -c ../fudami-design/tailwind.config.js -i ../fudami-design/css/fudami.css --content \"./public/*.html,./public/*.js,./public/vendor/*.js\" -o ./public/design-system.css -m",
    "test": "node --test test/*.test.js",
    "vendor:design": "cp ../fudami-design/dist/chrome.browser.js public/vendor/fudami-design.browser.js && cp ../fudami-design/dist/theme-boot.js public/vendor/theme-boot.js && cp -r ../fudami-design/dist/fonts public/vendor/"
  },
